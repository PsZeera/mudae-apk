rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /claims/{charId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /players/{nick} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /trades/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
